{
  "name": "ninerlog-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NinerLog - EASA/FAA Compliant Pilot Logbook (Frontend)",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:cross": "bash scripts/run-cross-browser-e2e.sh",
    "test:e2e:compat": "bash scripts/run-cross-browser-e2e.sh --compat-only chromium webkit firefox",
    "shots": "node scripts/screenshots/capture.mjs",
    "shots:marketing": "node scripts/screenshots/marketing.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "type-check": "node node_modules/typescript-7/bin/tsc --noEmit",
    "generate:api": "bash scripts/generate-api-client.sh",
    "generate:api:watch": "bash scripts/generate-api-client.sh && npx openapi-typescript https://raw.githubusercontent.com/fjaeckel/ninerlog-api/main/api-spec/openapi.yaml -o src/api/schema.ts --watch",
    "build:analyze": "ANALYZE=true npm run type-check && ANALYZE=true vite build",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@types/leaflet": "^1.9.22",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": ">=4.3.1 <5.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.12",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^6.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/js-yaml": "^4.0.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "gifenc": "^1.0.3",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-cli": "^7.4.1"
  },
  "overrides": {
    "js-yaml": ">=4.3.1 <5.0.0",
    "serialize-javascript": ">=7.0.5",
    "tmp": ">=0.2.7",
    "uuid": ">=14.0.0",
    "brace-expansion": ">=5.0.9",
    "filelist": ">=2.0.2",
    "@redocly/openapi-core": {
      "minimatch": ">=10.2.5"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
